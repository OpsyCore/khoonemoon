# Supabase (required)
# Project URL + anon key are exposed to the browser by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public app URL used in auth redirects and links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: direct Postgres connection (health check / server-side jobs only).
# Keep it empty when the app data layer runs through Supabase.
DATABASE_URL=

# Web Push (VAPID) — generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is shipped to the browser; NEVER commit the private key.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@khoonemoon.app

# Shared secret for the reminder dispatch endpoint (cron / external scheduler).
# Send it as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Server-side privileged key. Never expose it to the browser.
# Only needed for the operator smoke test (npm run smoke), not by the app itself.
SUPABASE_SERVICE_ROLE_KEY=
